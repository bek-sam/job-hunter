# Copy to .env and fill in. Never commit .env.
NOTION_TOKEN=            # internal integration secret (notion.so/my-integrations), connected to your "Jobs 2026" page
NTFY_TOPIC=              # optional: phone push via the free ntfy app (pick a long random topic name)
LOGIN_EMAIL=             # email used for ATS sign-in / account creation (password lives in macOS Keychain, service "jobhunter")

# Your Notion workspace: data source / page IDs (open the database -> Share -> Copy link; the 32-hex part)
NOTION_APPS_DS=          # Applications tracker (Company, Position, Status, Notes, Link, Location, Date Posted, ...)
NOTION_JOBS_HUB=         # optional hub page (links only)
NOTION_REPORTS_DS=       # optional: Manager / Outreach reports
NOTION_LIBRARY_DS=       # optional: docs library
NOTION_COMMUNITY_DS=     # optional: shared community job board
NOTION_EXPERIENCE_DS=    # resume bullet bank: Experience rows
NOTION_PROJECTS_DS=      # resume bullet bank: Projects rows

# Automation switches -- all OFF unless you set them to 1 (see jobhunter/auth.py)
AUTO_LOGIN=0
AUTO_CREATE_ACCOUNT=0
AUTO_VERIFY=0
AUTO_SUBMIT=0
AUTO_CONSENT=0
AUTO_SELF_ID=0

# Which ATSs auto-apply may run on (default greenhouse,ashby; "all" = every adapter). Others are SKIPPED for you.
APPLY_ATS_ONLY=greenhouse,ashby
# APPLY_FOCUS=...        # regex on the row Link for scheduled apply runs (default: Greenhouse/Ashby/Workday/LinkedIn/jobright)
RESCUE=1                 # 1 = when a single-page form is stuck, Claude (LLM) looks at it and fills the missing fields
KEEP_TABS=1              # leave "Needs you" forms open in the apply Chrome (max MAX_KEPT_TABS=20)
KEEP_FILLED_TABS=1       # with AUTO_SUBMIT=0: leave FILLED forms open for your Submit click
# RETRY_HOURS=0.9        # min hours between two apply attempts on the same row
# LI_RESOLVE=0           # 1 = look up where LinkedIn rows really apply via LinkedIn's internal API (against its terms)
# JD_WORKERS=8           # parallel job-page fetches in the hunter
# JOBHUNTER_TZ=America/Chicago   # your time zone (daily reports, 7 AM / 10 PM jobs, note stamps)
# KEEP_DAYS=60           # data/ logs older than this are pruned once a day (submissions.jsonl is never pruned)

APPROVAL_QUEUE=0         # 1 = Apply Prep fills only rows you set to Status "Approved" (new rows wait in "To apply")
BULLET_REWORD=1          # swap a few words of bank bullets for the job's exact terms (validated; pinned bullets untouched)
RESUME_TITLE_LINE=0      # 1 = print the posting's title under your contact line

# LLM_MODEL=sonnet       # cover letters
# FIT_GATE=70
# WINDOW_MIN=20
# SKILLS_MODE=evidence   # evidence = only skills you have evidence for (default); all = every JD skill
# SKILLS_UNPROVEN_MAX=-1 # JD skills without evidence on the resume (-1 = all; Skills lines are always filled)
# PER_COMPANY_MAX=0      # applications per company ...
# PER_COMPANY_DAYS=30    # ... per this many days
# TITLE_STRICT=1         # only core SWE / full-stack / mobile / AI titles
# PROFILE=/path/to/profile.json   # default: ./profile.json
# Career-Ops evaluation (vendor/career-ops): 1 LLM call per job that passes FIT_GATE; skip below EVAL_GATE/5
CAREER_EVAL=1
EVAL_GATE=4.0
EVAL_MODEL=sonnet
# Oct 28 2026 features (from the open-source repo review)
JOBSPY=1                 # Indeed / ZipRecruiter / Google Jobs via python-jobspy
JOBSPY_SITES=indeed,zip_recruiter,google
GHOST_DAYS=30            # manager.py: Applied + silent this long -> Ghosted
# CAPTCHA_WAIT=180       # seconds the run waits for you to solve a CAPTCHA in the open tab (0 = stop as NEEDS YOU)

# apply_prep: after fresh (48 h) rows, also work To apply rows up to this many days old (0-2 = fresh only)
BACKLOG_DAYS=14
# apply_prep: delete failure .trace.zip recordings older than this many days (they are 2-4 GB/day)
TRACE_KEEP_DAYS=1

# LLM provider: claude or codex (Codex uses your existing CLI login).
LLM_PROVIDER=claude
# CODEX_MODEL=
