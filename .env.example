# Copy to .env and fill in. Never commit .env.
NOTION_TOKEN=            # internal integration secret (notion.so/my-integrations), connected to your "Jobs 2026" page
NTFY_TOPIC=              # optional: phone push via the free ntfy app (pick a long random topic name)
LOGIN_EMAIL=             # email used for ATS sign-in / account creation (password lives in macOS Keychain, service "jobhunter")

# Your Notion workspace: data source / page IDs (open the database -> Share -> Copy link; the 32-hex part)
NOTION_APPS_DS=          # Applications tracker (Company, Position, Status, Notes, Link, Location, Date Posted, ...)
NOTION_JOBS_HUB=         # optional hub page (links only)
NOTION_REPORTS_DS=       # optional: Manager / Outreach reports
NOTION_LIBRARY_DS=       # optional: docs library
NOTION_COMMUNITY_DS=     # optional: shared community job board
NOTION_EXPERIENCE_DS=    # resume bullet bank: Experience rows
NOTION_PROJECTS_DS=      # resume bullet bank: Projects rows

# Automation switches -- all OFF unless you set them to 1 (see jobhunter/auth.py)
AUTO_LOGIN=0
AUTO_CREATE_ACCOUNT=0
AUTO_VERIFY=0
AUTO_SUBMIT=0
AUTO_CONSENT=0
AUTO_SELF_ID=0

# LLM_MODEL=sonnet       # cover letters
# FIT_GATE=70
# WINDOW_MIN=20
# SKILLS_MODE=evidence   # evidence = only skills you have evidence for (default); all = every JD skill
# SKILLS_MAX=15          # max tools in the resume Skills section
# PER_COMPANY_MAX=1      # applications per company ...
# PER_COMPANY_DAYS=30    # ... per this many days
# TITLE_STRICT=1         # only core SWE / full-stack / mobile / AI titles
# PROFILE=/path/to/profile.json   # default: ./profile.json
# Career-Ops evaluation (vendor/career-ops): 1 LLM call per job that passes FIT_GATE; skip below EVAL_GATE/5
CAREER_EVAL=1
EVAL_GATE=4.0
EVAL_MODEL=sonnet
# Oct 28 2026 features (from the open-source repo review)
JOBSPY=1                 # Indeed / ZipRecruiter / Google Jobs via python-jobspy
JOBSPY_SITES=indeed,zip_recruiter,google
GHOST_DAYS=30            # manager.py: Applied + silent this long -> Ghosted
# CAPTCHA_WAIT=180       # seconds the run waits for you to solve a CAPTCHA in the open tab (0 = stop as NEEDS YOU)
